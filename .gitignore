# Paper C raw spectral dumps (per-state-unit lists are too large
# for git; commit the *_summary.json instead, which drops the
# 80K-element flat lists per layer and keeps aggregate stats only)
paper_c/results_c/phase_c1_ssm_spectral_baseline.json
paper_c/results_c/phase_c1b_*.json
paper_c/results_c/phase_c1c_*.json
!paper_c/results_c/*_summary.json
